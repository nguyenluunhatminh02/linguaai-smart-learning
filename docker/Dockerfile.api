FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
# .npmrc controls pnpm's linker/layout; it must be present at install time so
# the module tree built here matches what the runner copies.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
# Restore the .npmrc used during install so pnpm resolves workspace links the
# same way it did in the deps stage.
COPY .npmrc ./
COPY apps/api ./apps/api
COPY packages/shared ./packages/shared
COPY turbo.json ./
RUN pnpm run db:generate --filter=api
RUN pnpm run build --filter=api

FROM node:22-alpine AS runner
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 appuser
WORKDIR /app
ENV NODE_ENV=production
# OpenSSL is required by Prisma 7's query engine on Alpine.
RUN apk add --no-cache openssl wget
# Preserve the exact workspace layout produced by pnpm. Re-rooting
# apps/api/node_modules at /app/node_modules breaks relative symlinks into
# /app/node_modules/.pnpm and the .bin shims, so the app cannot resolve any
# dependency at runtime.
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/packages/shared/src ./packages/shared/src
USER appuser
WORKDIR /app/apps/api
EXPOSE 3001
# Liveness only. Readiness (/api/health/ready) must be checked by the
# orchestrator with 200/503 semantics; see docker/README.md.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=20s \
  CMD wget -qO- http://localhost:3001/api/health >/dev/null || exit 1
# Schema migrations are applied by the one-shot `migrate` compose service,
# never by each API replica. Seeding is likewise a separate explicit job.
CMD ["node", "dist/main.js"]
