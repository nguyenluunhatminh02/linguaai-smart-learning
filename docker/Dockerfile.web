FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile

FROM base AS builder
# NEXT_PUBLIC_* envs are inlined into the client bundle at BUILD time.
# Require an explicit build arg: a localhost fallback would silently ship a
# production image that calls the operator's own machine. Runtime env changes
# cannot rewrite the inlined value; rebuild the web image to change it.
ARG NEXT_PUBLIC_API_URL
RUN test -n "$NEXT_PUBLIC_API_URL" || (echo "NEXT_PUBLIC_API_URL build arg is required" >&2; exit 1)
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Server-only route variables are supplied at runtime by compose (never
# NEXT_PUBLIC_*); no default here, since a wrong host resolves inside this
# container and hides configuration errors.
# Standalone output is only emitted in container builds.
ENV BUILD_STANDALONE=true
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
COPY turbo.json ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm run build --filter=web

FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
# outputFileTracingRoot points at the monorepo root, so the standalone tree
# preserves the workspace layout: the launchable server is apps/web/server.js.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 3000
ENV PORT=3000
CMD ["node", "apps/web/server.js"]
