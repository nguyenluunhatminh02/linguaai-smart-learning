# Pin the interpreter patch release and the multi-arch manifest digest so
# builds are reproducible; the digest is shared by base/deps/runner.
FROM python:3.12.3-slim-bookworm@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63 AS base
WORKDIR /app

FROM base AS deps
COPY apps/ai-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip check

FROM base AS runner
RUN addgroup --system --gid 1001 aigroup && \
    adduser --system --uid 1001 aiuser
WORKDIR /app
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
# LOG_DIR in app/main.py resolves to /app/logs (parent of app/main.py); the
# directory must exist and be owned by the runtime uid before USER switches.
COPY --chown=1001:1001 apps/ai-service/app ./app
RUN mkdir -p /app/logs && chown 1001:1001 /app/logs
USER 1001:1001
EXPOSE 8000
# Liveness only: /health is local and cheap. /ready calls the LLM provider and
# is deliberately not used as a restart gate. --start-period covers uvicorn
# startup so slow boots are not counted as failures.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=20s \
  CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).status == 200 else 1)" || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
