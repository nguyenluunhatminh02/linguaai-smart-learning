# Copy to .env.local and replace <...> placeholders locally. Never commit real values.
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time: no secrets there.
# See docs/provider-setup.md for variable names, owners and rotation.

# ── API (public build-time configuration) ──
# Full URL used by clients and server routes. next.config.ts derives the CSP
# connect-src/img-src/media-src origin from this value, so it must include
# scheme + host (the /api/v1 path is ignored for CSP origin matching).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# AI service proxy URL (public by design; must not contain a credential).
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
# Set to true only for local development bypassing middleware auth (never in production).
NEXT_PUBLIC_DISABLE_AUTH=false

# ── CMS Backend (optional, server-side) ──
CMS_BACKEND_URL=http://localhost:4000/api/v1

# ── Groq (transitional: server-side Next.js routes still call Groq directly) ──
# Do not add new web routes that read this key; move them behind the API and
# remove this variable from apps/web when those routes are migrated.
GROQ_API_KEY=<replace-with-groq-api-key>
# Model id (not a secret).
GROQ_MODEL=llama-3.3-70b-versatile
