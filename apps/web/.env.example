# ── API ──
# Full URL used by clients and server routes. next.config.ts derives the CSP
# connect-src/img-src/media-src origin from this value, so it must include
# scheme + host (the /api/v1 path is ignored for CSP origin matching).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Set to true only for local development bypassing middleware auth (never in production).
NEXT_PUBLIC_DISABLE_AUTH=false

# ── CMS Backend (optional) ──
CMS_BACKEND_URL=http://localhost:4000/api/v1

# ── Groq (server-side only, used in API routes) ──
# Use a real key from https://console.groq.com/keys — the placeholder below is not valid.
GROQ_API_KEY=
# Verified Groq model ids: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
