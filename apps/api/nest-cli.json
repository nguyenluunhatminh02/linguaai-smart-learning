{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "generated/**/*",
        "outDir": "./dist",
        "watchAssets": true
      }
    ]
  }
}
