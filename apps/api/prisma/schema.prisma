generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model login_history {
  id             String                    @id(map: "PK_fe377f36d49c39547cb6b9f0727") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  action         login_history_action_enum
  ip_address     String?                   @db.VarChar
  user_agent     String?                   @db.VarChar(512)
  device_info    String?                   @db.VarChar
  success        Boolean?
  failure_reason String?                   @db.VarChar
  created_at     DateTime                  @default(now()) @db.Timestamp(6)
  user_id        String?                   @db.Uuid
  users          users?                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ad9ce49cb73c0b33746a56b6bd1")
}

model notifications {
  id         String                     @id(map: "PK_6a72c3c0f683f6462415e653c3a") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title      String                     @db.VarChar(255)
  message    String                     @db.VarChar(2000)
  type       notifications_type_enum
  channel    notifications_channel_enum
  is_read    Boolean                    @default(false)
  read_at    DateTime?                  @db.Timestamp(6)
  data       String?                    @db.VarChar(2000)
  created_at DateTime                   @default(now()) @db.Timestamp(6)
  user_id    String?                    @db.Uuid
  users      users?                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_9a8a82462cab47c73d25f49261f")

  @@index([created_at], map: "idx_notification_created_at")
  @@index([is_read], map: "idx_notification_is_read")
  @@index([user_id], map: "idx_notification_user_id")
}

model refresh_tokens {
  id             String    @id(map: "PK_7d8bee0204106019488c4c50ffa") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token          String    @unique(map: "UQ_4542dd2f38a61354a040ba9fd57") @db.VarChar
  is_revoked     Boolean   @default(false)
  expires_at     DateTime  @db.Timestamp(6)
  user_agent     String?   @db.VarChar(512)
  ip_address     String?   @db.VarChar
  device_info    String?   @db.VarChar
  last_active_at DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  user_id        String?   @db.Uuid
  users          users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_3ddc983c5f7bcf132fd8732c3f4")
}

model roles {
  id         String          @id(map: "PK_c1433d71a4838793a49dcad46ab") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       roles_name_enum @unique(map: "UQ_648e3f5447f725579d7d4ffdfb7")
  user_roles user_roles[]
}

model security_questions {
  id          String   @id(map: "PK_40863dac02e72e1ea928b07d5ad") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question    String   @db.VarChar(500)
  answer_hash String   @db.VarChar(255)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String?  @db.Uuid
  users       users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_f2c2fb415138d89ce45146e5fe3")
}

model user_roles {
  users_id String @db.Uuid
  roles_id String @db.Uuid
  roles    roles  @relation(fields: [roles_id], references: [id], onDelete: Cascade, map: "FK_4a08d003e00caf075a4a212d23d")
  users    users  @relation(fields: [users_id], references: [id], onDelete: Cascade, map: "FK_8e1215206acb19f1c38dbda9091")

  @@id([users_id, roles_id], map: "PK_65ec3daed53f391c53df7e2e8fb")
  @@index([roles_id], map: "IDX_4a08d003e00caf075a4a212d23")
  @@index([users_id], map: "IDX_8e1215206acb19f1c38dbda909")
}

model users {
  id                             String                   @id(map: "PK_a3ffb1c0c8416b9fc6f907b7433") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  created_at                     DateTime                 @default(now()) @db.Timestamp(6)
  updated_at                     DateTime                 @default(now()) @db.Timestamp(6)
  email                          String                   @unique(map: "UQ_97672ac88f789774dd47f7c8be3") @db.VarChar
  password                       String?                  @db.VarChar
  first_name                     String                   @db.VarChar
  last_name                      String                   @db.VarChar
  phone                          String?                  @db.VarChar
  avatar_url                     String?                  @db.VarChar
  date_of_birth                  DateTime?                @db.Date
  gender                         String?                  @db.VarChar(20)
  provider                       users_provider_enum      @default(LOCAL)
  provider_id                    String?                  @db.VarChar
  email_verified                 Boolean                  @default(false)
  email_verification_token       String?                  @db.VarChar
  email_verification_expiry      DateTime?                @db.Timestamp(6)
  password_reset_token           String?                  @db.VarChar
  password_reset_expiry          DateTime?                @db.Timestamp(6)
  two_factor_enabled             Boolean                  @default(false)
  is_active                      Boolean                  @default(true)
  is_locked                      Boolean                  @default(false)
  failed_login_attempts          Int                      @default(0)
  lock_time                      DateTime?                @db.Timestamp(6)
  last_login_at                  DateTime?                @db.Timestamp(6)
  last_login_ip                  String?                  @db.VarChar(50)
  is_deleted                     Boolean                  @default(false)
  deleted_at                     DateTime?                @db.Timestamp(6)
  language                       String                   @default("en") @db.VarChar(10)
  timezone                       String                   @default("UTC") @db.VarChar(50)
  notification_email_enabled     Boolean                  @default(true)
  notification_push_enabled      Boolean                  @default(true)
  notification_in_app_enabled    Boolean                  @default(true)
  notification_security_enabled  Boolean                  @default(true)
  profile_public                 Boolean                  @default(false)
  show_email                     Boolean                  @default(false)
  show_phone                     Boolean                  @default(false)
  show_activity_status           Boolean                  @default(true)
  delete_status                  users_delete_status_enum @default(ACTIVE)
  delete_requested_at            DateTime?                @db.Timestamp(6)
  fcm_token                      String?                  @db.VarChar(500)
  max_devices                    Int                      @default(3)
  email_verified_at              DateTime?                @db.Timestamp(6)
  password_changed_at            DateTime?                @db.Timestamp(6)
  // Language learning gamification fields
  streak_count                   Int                      @default(0)
  total_xp                       Int                      @default(0)
  daily_goal                     Int                      @default(20)
  learning_level                 String?                  @db.VarChar(10)
  daily_study_minutes            Int?
  daily_word_goal                Int                      @default(10)
  preferred_language             String                   @default("english") @db.VarChar(50)
  native_language                String?                  @db.VarChar(50)
  target_language                String?                  @db.VarChar(50)
  login_history                  login_history[]
  notifications                  notifications[]
  refresh_tokens                 refresh_tokens[]
  security_questions             security_questions[]
  user_roles                     user_roles[]
  password_history               password_history[]
  oauth_accounts                 oauth_accounts[]
  verification_tokens            verification_tokens[]
  mfa_secret                     mfa_secrets?
  user_devices                   user_devices[]
  login_attempts                 login_attempts[]
  audit_logs                     audit_logs[]
  // Learning platform relations
  decks                          decks[]
  writing_submissions            writing_submissions[]
  speaking_submissions           speaking_submissions[]
  reading_passages               reading_passages[]
  chat_conversations             chat_conversations[]
  quiz_attempts                  quiz_attempts[]
  user_card_progress             user_card_progress[]
  srs_review_events              srs_review_events[]
  learning_completions           learning_completions[]
  learning_attempts             learning_attempts[]
  review_sessions                review_sessions[]
  user_streaks                   user_streaks[]
  user_badges                    user_badges[]
  quizzes                        quizzes[]
  token_balance                  user_token_balance?
  token_transactions             token_transactions[]
  ai_operations                  ai_operations[]
  daily_credit_grants            daily_credit_grants[]
  daily_plans                   daily_plans[]
  // PRODUCT-02/03: mastery evidence (additive; migration 20261129002000_knowledge_map).
  learner_mastery               learner_mastery[]
  mastery_events                mastery_events[]
  learner_errors                learner_errors[]

  @@index([email_verification_token], map: "idx_users_email_verification_token")
  @@index([password_reset_token], map: "idx_users_password_reset_token")
}

model password_history {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  user_id       String?  @db.Uuid
  users         users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

enum login_history_action_enum {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  LOGOUT_SESSION
  MFA_ENABLED
  MFA_DISABLED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_DELETED
}

enum notifications_channel_enum {
  EMAIL
  PUSH
  IN_APP
  WEB_PUSH
}

enum notifications_type_enum {
  SYSTEM
  SECURITY
  ACCOUNT
}

enum roles_name_enum {
  ADMIN
  USER
  MODERATOR
}

enum users_delete_status_enum {
  ACTIVE
  DELETE_REQUESTED
  GRACE_PERIOD
  PERMANENTLY_DELETED
}

enum users_provider_enum {
  LOCAL
  GOOGLE
  GITHUB
}

// ──────────────────────────────────────────────────────────────────────────────
// AUTH & SECURITY MODELS
// ──────────────────────────────────────────────────────────────────────────────

model oauth_accounts {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  provider         String    @db.VarChar(50)
  provider_user_id String    @db.VarChar(255)
  email            String?   @db.VarChar(255)
  name             String?   @db.VarChar(255)
  image_url        String?   @db.VarChar(500)
  access_token     String?   @db.VarChar
  refresh_token    String?   @db.VarChar
  expires_at       DateTime? @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([user_id])
}

model verification_tokens {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token_hash String   @unique @db.VarChar(255)
  type       String   @db.VarChar(50)
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamp(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model mfa_secrets {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id           String    @unique @db.Uuid
  secret_encrypted  String    @db.VarChar
  enabled           Boolean   @default(false)
  backup_codes      String?   @db.VarChar
  verified          Boolean   @default(false)
  verified_at       DateTime? @db.Timestamp(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_devices {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  device_id        String    @unique @db.VarChar(255)
  fingerprint      String?   @db.VarChar(255)
  device_name      String?   @db.VarChar(255)
  device_type      String?   @db.VarChar(50)
  browser          String?   @db.VarChar(100)
  browser_version  String?   @db.VarChar(50)
  operating_system String?   @db.VarChar(100)
  os_version       String?   @db.VarChar(50)
  ip_address       String?   @db.VarChar(50)
  location         String?   @db.VarChar(255)
  user_agent       String?   @db.VarChar(512)
  active           Boolean   @default(true)
  trusted          Boolean   @default(false)
  last_active_at   DateTime? @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([fingerprint])
}

model login_attempts {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String?   @db.Uuid
  email          String    @db.VarChar(255)
  ip_address     String    @db.VarChar(50)
  device_info    String?   @db.VarChar(512)
  success        Boolean
  failure_reason String?   @db.VarChar(255)
  attempted_at   DateTime  @default(now()) @db.Timestamp(6)
  users          users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([ip_address])
}

model audit_logs {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String?   @db.Uuid
  action        String    @db.VarChar(100)
  resource      String?   @db.VarChar(100)
  resource_type String?   @db.VarChar(100)
  resource_id   String?   @db.VarChar(255)
  details       String?   @db.VarChar
  ip_address    String?   @db.VarChar(50)
  user_agent    String?   @db.VarChar(512)
  device_id     String?   @db.VarChar(255)
  success       Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
}

// ──────────────────────────────────────────────────────────────────────────────
// LANGUAGE LEARNING PLATFORM MODELS
// ──────────────────────────────────────────────────────────────────────────────

model decks {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String           @db.VarChar(255)
  description    String           @default("") @db.VarChar(1000)
  language       String           @default("english") @db.VarChar(50)
  level          String           @default("A1") @db.VarChar(10)
  is_public      Boolean          @default(false)
  creator_id     String           @db.Uuid
  card_count     Int              @default(0)
  learning_collection String?     @db.VarChar(30)
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  users          users            @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  cards          cards[]
  review_sessions review_sessions[]
  quizzes        quizzes[]

  @@index([creator_id])
  @@unique([creator_id, learning_collection])
}

model cards {
  id                String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  deck_id           String               @db.Uuid
  front_text        String               @db.VarChar(500)
  back_text         String               @db.VarChar(500)
  ipa_pronunciation String?              @db.VarChar(255)
  audio_url         String?              @db.VarChar(500)
  example_sentence  String?              @db.VarChar(1000)
  image_url         String?              @db.VarChar(500)
  seed_key          String?              @db.VarChar(500)
  retired_at        DateTime?            @db.Timestamp(6)
  learning_phrase_key String?            @db.VarChar(120)
  created_at        DateTime             @default(now()) @db.Timestamp(6)
  decks             decks                @relation(fields: [deck_id], references: [id], onDelete: Cascade)
  user_card_progress user_card_progress[]
  srs_review_events  srs_review_events[]

  @@index([deck_id])
  @@unique([deck_id, seed_key])
  @@unique([deck_id, learning_phrase_key])
}

// DB-02/DB-04: one summary row per (user, activity_type, activity_id).
// The unique key intentionally stays unchanged: existing activity IDs are not
// proven to be language-scoped, and adding `language` would require a separate
// duplicate-safe migration. Per-language attempt history lives in learning_attempts.
model learning_completions {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String   @db.Uuid
  activity_type String   @db.VarChar(20)
  activity_id   String   @db.VarChar(160)
  language      String   @db.VarChar(30)
  score         Int?
  total         Int?
  duration_seconds Int  @default(0)
  completed_at  DateTime @default(now()) @db.Timestamp(6)
  // Additive summary fields. Nulls mark legacy rows with no recorded history;
  // no attempt rows are fabricated when these are backfilled.
  first_completed_at     DateTime? @db.Timestamp(6)
  last_completed_at      DateTime? @db.Timestamp(6)
  attempt_count          Int       @default(0)
  best_score             Int?
  latest_score           Int?
  total_duration_seconds Int       @default(0)
  is_legacy              Boolean   @default(false)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, activity_type, activity_id])
  @@index([user_id, language, completed_at])
}

// DB-02/DB-04: append-only learning attempt history. client_attempt_id is
// client-generated so retries of the same intent reuse one row instead of
// inflating attempt_count or re-crediting XP.
model learning_attempts {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id           String    @db.Uuid
  language          String?   @db.VarChar(30)
  activity_type     String?   @db.VarChar(20)
  activity_id       String?   @db.VarChar(160)
  content_version   String?   @db.VarChar(50)
  client_attempt_id String    @db.Uuid
  raw_score         Float?
  score_scale       String?   @db.VarChar(20)
  normalized_score  Float?
  total             Int?
  duration_seconds  Int       @default(0)
  started_at        DateTime? @db.Timestamp(6)
  completed_at      DateTime  @default(now()) @db.Timestamp(6)
  feedback_ref      String?   @db.VarChar(160)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, client_attempt_id], map: "learning_attempts_user_id_client_attempt_id_key")
  @@index([user_id, language, completed_at], map: "learning_attempts_user_id_language_completed_at_idx")
}

model srs_review_events {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  card_id    String   @db.Uuid
  result     Json
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cards      cards    @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([card_id])
}

model user_card_progress {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  card_id          String    @db.Uuid
  ease_factor      Float     @default(2.5)
  difficulty       Float     @default(5.0)
  interval_days    Int       @default(0)
  repetition_count Int       @default(0)
  next_review_date DateTime  @default(now()) @db.Timestamp(6)
  last_review_date DateTime? @db.Timestamp(6)
  quality_history  Json      @default("[]")
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cards            cards     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([user_id, card_id])
  @@index([user_id])
  @@index([card_id])
  @@index([next_review_date])
}

model review_sessions {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String    @db.Uuid
  deck_id         String    @db.Uuid
  cards_reviewed  Int       @default(0)
  cards_correct   Int       @default(0)
  duration_seconds Int      @default(0)
  started_at      DateTime  @default(now()) @db.Timestamp(6)
  finished_at     DateTime? @db.Timestamp(6)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  decks           decks     @relation(fields: [deck_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([deck_id])
  @@index([started_at])
}

model writing_submissions {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String   @db.Uuid
  prompt_text String?  @db.VarChar(2000)
  user_text   String
  ai_feedback Json?
  score       Json?
  language    String   @default("english") @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// S6: Speaking session history. Stores transcript + feedback so users can
// review past attempts. Audio file storage is intentionally optional.
model speaking_submissions {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String   @db.Uuid
  topic        String?  @db.VarChar(500)
  transcript   String
  feedback     String
  scores       Json?
  language     String   @default("english") @db.VarChar(50)
  level        String   @default("B1") @db.VarChar(10)
  duration_sec Int      @default(0)
  audio_url    String?  @db.VarChar(500)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}

model reading_passages {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  generated_by_user_id  String   @db.Uuid
  passage_text          String
  vocabulary            Json     @default("[]")
  questions             Json     @default("[]")
  level                 String   @default("A1") @db.VarChar(10)
  topic                 String   @default("") @db.VarChar(255)
  language              String   @default("english") @db.VarChar(50)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  users                 users    @relation(fields: [generated_by_user_id], references: [id], onDelete: Cascade)

  @@index([generated_by_user_id])
}

model chat_conversations {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String         @db.Uuid
  title        String         @default("New Conversation") @db.VarChar(255)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat_messages chat_messages[]

  @@index([user_id])
}

model chat_messages {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversation_id String             @db.Uuid
  role            String             @default("user") @db.VarChar(20)
  content         String
  created_at      DateTime           @default(now()) @db.Timestamp(6)
  chat_conversations chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
}

model quizzes {
  language           String?          @db.VarChar(50)
  id                 String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title              String          @db.VarChar(255)
  description        String          @default("") @db.VarChar(1000)
  deck_id            String?         @db.Uuid
  creator_id         String          @db.Uuid
  time_limit_minutes Int             @default(15)
  created_at         DateTime        @default(now()) @db.Timestamp(6)
  users              users           @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  decks              decks?          @relation(fields: [deck_id], references: [id], onDelete: SetNull)
  quiz_questions     quiz_questions[]
  quiz_attempts      quiz_attempts[]

  @@index([creator_id])
}

model quiz_questions {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  quiz_id        String  @db.Uuid
  question_text  String  @db.VarChar(1000)
  question_type  String  @default("mcq") @db.VarChar(50)
  options        Json?
  correct_answer String  @db.VarChar(500)
  explanation    String  @default("") @db.VarChar(1000)
  difficulty     Int     @default(3)
  quizzes        quizzes @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
}

model quiz_attempts {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  quiz_id          String   @db.Uuid
  user_id          String   @db.Uuid
  score            Int      @default(0)
  total_questions  Int      @default(0)
  answers          Json     @default("[]")
  duration_seconds Int      @default(0)
  completed_at     DateTime @default(now()) @db.Timestamp(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  quizzes          quizzes  @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([quiz_id])
}

model user_streaks {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String  @db.Uuid
  date            String  @db.VarChar(10)
  xp_earned       Int     @default(0)
  minutes_studied Int     @default(0)
  users           users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, date])
  @@index([user_id])
}

model badges {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String       @db.VarChar(100)
  description String       @default("") @db.VarChar(500)
  icon_url    String?      @db.VarChar(500)
  condition   Json         @default("{}")
  user_badges user_badges[]
}

model user_badges {
  user_id   String   @db.Uuid
  badge_id  String   @db.Uuid
  earned_at DateTime @default(now()) @db.Timestamp(6)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  badges    badges   @relation(fields: [badge_id], references: [id], onDelete: Cascade)

  @@id([user_id, badge_id])
  @@index([user_id])
}

model content_items {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  title_vi   String   @default("") @db.VarChar(255)
  level      String   @default("A1") @db.VarChar(10)
  category   String   @default("") @db.VarChar(100)
  content    String   @default("")
  data       Json     @default("{}")
  questions  Json     @default("[]")
  audio_url  String   @default("") @db.VarChar(500)
  duration   String   @default("") @db.VarChar(50)
  word_count Int      @default(0)
  published  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)

  @@index([type])
  @@index([published])
}

// ──────────────────────────────────────────────────────────────────────────────
// Token economy: server-authoritative balance + audit trail.
// The client MUST treat the server as the source of truth.
// ──────────────────────────────────────────────────────────────────────────────

model user_token_balance {
  user_id String @id @db.Uuid
  balance Int    @default(0)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model token_transactions {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String   @db.Uuid
  amount          Int      // positive = purchase / bonus, negative = consumption
  type            String   @db.VarChar(20) // "purchase", "consumption", "bonus", "refund"
  feature         String   @default("") @db.VarChar(50) // e.g. "ai_chat", "ai_writing"
  balance_after   Int      @default(0)
  idempotency_key String?  @unique @db.VarChar(128)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([idempotency_key])
}

// BILL-03: durable AI operation ledger. Only a canonical request hash is
// stored; conversation_id/result_ref are intentionally plain UUIDs so this
// slice does not couple to chat/session ownership rules.
model ai_operations {
  id                 String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String                     @db.Uuid
  feature            String                     @db.VarChar(50)
  client_operation_id String                    @db.VarChar(128)
  request_hash       String                     @db.VarChar(64) // hex SHA-256 of canonical validated payload
  pricing_version    String                     @db.VarChar(50)
  reserved_credits   Int
  charged_credits    Int                        @default(0)
  status             ai_operations_status_enum  @default(RESERVED)
  attempt_count      Int                        @default(0)
  lease_until        DateTime?                  @db.Timestamp(6)
  lease_token        String?                    @db.VarChar(128)
  version            Int                        @default(0)
  conversation_id    String?                    @db.Uuid
  result_ref         String?                    @db.Uuid
  error_code         String?                    @db.VarChar(100)
  created_at         DateTime                   @default(now()) @db.Timestamp(6)
  updated_at         DateTime                   @default(now()) @db.Timestamp(6)
  finished_at        DateTime?                  @db.Timestamp(6)
  users              users                      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, feature, client_operation_id])
  @@index([status, lease_until])
  @@index([user_id])
}

enum ai_operations_status_enum {
  RESERVED
  RUNNING
  SUCCEEDED
  FAILED
  UNKNOWN
  CANCELLED
}

// BILL-05: durable once-per-day marker for daily top-up and check-in grants.
// A row is written even when amount = 0 so a processed UTC day is recorded.
model daily_credit_grants {
  id         String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String                  @db.Uuid
  grant_type daily_credit_grant_type
  day        DateTime                @db.Date
  amount     Int                     @default(0)
  created_at DateTime                @default(now()) @db.Timestamp(6)
  updated_at DateTime                @default(now()) @db.Timestamp(6)
  users      users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, grant_type, day])
  @@index([user_id, day])
}

enum daily_credit_grant_type {
  DAILY_TOPUP
  DAILY_CHECKIN
}

// PRODUCT-02: curated knowledge map and PRODUCT-03 mastery evidence.
// All tables are additive; canonical shapes follow the 20261129* raw SQL.
model knowledge_items {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  language    String   @db.VarChar(30)
  skill       String   @db.VarChar(50)
  code        String   @db.VarChar(160)
  level       String?  @db.VarChar(30)
  title       String   @db.VarChar(255)
  description String?
  version     Int      @default(1)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)

  prerequisites    knowledge_prerequisites[]  @relation("KnowledgePrerequisites")
  prerequisite_for knowledge_prerequisites[]  @relation("KnowledgePrerequisiteFor")
  activity_links   activity_knowledge_items[]
  learner_mastery  learner_mastery[]
  mastery_events   mastery_events[]
  learner_errors   learner_errors[]

  @@unique([language, code, version], map: "knowledge_items_language_code_version_key")
  @@index([language, skill, level], map: "knowledge_items_language_skill_level_idx")
  @@index([code, version], map: "knowledge_items_code_version_idx")
  @@index([language, skill], map: "knowledge_items_language_skill_idx")
}

model knowledge_prerequisites {
  knowledge_id    String          @db.Uuid
  prerequisite_id String          @db.Uuid
  knowledge       knowledge_items @relation("KnowledgePrerequisites", fields: [knowledge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prerequisite    knowledge_items @relation("KnowledgePrerequisiteFor", fields: [prerequisite_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([knowledge_id, prerequisite_id], map: "knowledge_prerequisites_pkey")
  @@index([prerequisite_id], map: "knowledge_prerequisites_prerequisite_id_idx")
}

model activity_knowledge_items {
  activity_type   String          @db.VarChar(50)
  activity_id     String          @db.VarChar(160)
  content_version String          @default("1") @db.VarChar(50)
  knowledge_id    String          @db.Uuid
  weight          Float           @default(1)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  knowledge       knowledge_items @relation(fields: [knowledge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([activity_type, activity_id, content_version, knowledge_id], map: "activity_knowledge_items_pkey")
  @@index([knowledge_id], map: "activity_knowledge_items_knowledge_id_idx")
}

// PRODUCT-04: idempotent daily learning plans. Shape and column names follow
// the 20261129004000_daily_plans raw SQL. Status columns are plain VARCHAR,
// matching the migration rather than native PostgreSQL enums.
model daily_plans {
  id           String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String             @db.Uuid
  day          DateTime           @db.Date
  version      Int                @default(1)
  timezone     String             @default("UTC") @db.VarChar(50)
  status       String             @default("ACTIVE") @db.VarChar(20)
  generated_at DateTime           @default(now()) @db.Timestamp(6)
  updated_at   DateTime           @default(now()) @db.Timestamp(6)
  users        users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items        daily_plan_items[]

  @@unique([user_id, day, version], map: "daily_plans_user_id_day_version_key")
  @@index([user_id, day], map: "daily_plans_user_id_day_idx")
}

model daily_plan_items {
  id                String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  plan_id           String      @db.Uuid
  order_index       Int
  activity_type     String      @db.VarChar(50)
  activity_id       String      @db.VarChar(160)
  estimated_minutes Int         @default(10)
  reason            String?
  status            String      @default("PENDING") @db.VarChar(20)
  knowledge_tags    Json        @db.Json @default("[]")
  created_at        DateTime    @default(now()) @db.Timestamp(6)
  updated_at        DateTime    @default(now()) @db.Timestamp(6)
  daily_plan        daily_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([plan_id, order_index], map: "daily_plan_items_plan_id_order_index_key")
  @@index([plan_id, status], map: "daily_plan_items_plan_id_status_idx")
}

// PRODUCT-02/03: per-learner mastery derived from append-only evidence.
// Additive models mirroring the raw-SQL tables created by
// 20261129002000_knowledge_map. No existing table or column is changed.
model learner_mastery {
  user_id           String          @db.Uuid
  knowledge_id      String          @db.Uuid
  success_weight    Float           @default(0)
  failure_weight    Float           @default(0)
  evidence_count    Int             @default(0)
  last_practiced_at DateTime?       @db.Timestamp(6)
  updated_at        DateTime        @default(now()) @db.Timestamp(6)
  users             users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledge         knowledge_items @relation(fields: [knowledge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, knowledge_id], map: "learner_mastery_pkey")
  @@index([user_id, last_practiced_at], map: "learner_mastery_user_id_last_practiced_at_idx")
  @@index([knowledge_id], map: "learner_mastery_knowledge_id_idx")
  @@index([user_id, evidence_count, last_practiced_at], map: "learner_mastery_user_id_evidence_count_last_practiced_at_idx")
}

// Append-only evidence log. The unique key on (attempt_id, knowledge_id,
// evidence_type) is the durable idempotency guard: a retried attempt cannot
// apply the same evidence twice. attempt_id is deliberately VARCHAR so it can
// hold external/legacy identifiers without a FK to learning_attempts.
model mastery_events {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String          @db.Uuid
  attempt_id    String          @db.VarChar(160)
  knowledge_id  String          @db.Uuid
  evidence_type String          @db.VarChar(50)
  score         Float
  weight        Float           @default(1)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledge     knowledge_items @relation(fields: [knowledge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attempt_id, knowledge_id, evidence_type], map: "mastery_events_attempt_id_knowledge_id_evidence_type_key")
  @@index([user_id, created_at, id], map: "mastery_events_user_id_created_at_id_idx")
  @@index([user_id, created_at], map: "mastery_events_user_id_created_at_idx")
  @@index([attempt_id], map: "mastery_events_attempt_id_idx")
  @@index([knowledge_id, created_at], map: "mastery_events_knowledge_id_created_at_idx")
}

// Error log for the error-to-flashcard pipeline. Excerpt is intentionally
// minimal (no raw audio/full text); status and confidence are app-owned.
model learner_errors {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String           @db.Uuid
  attempt_id   String?          @db.VarChar(160)
  knowledge_id String?          @db.Uuid
  error_type   String           @db.VarChar(80)
  excerpt      String?
  correction   String?
  confidence   Float?
  status       String           @default("OPEN") @db.VarChar(30)
  created_at   DateTime         @default(now()) @db.Timestamp(6)
  users        users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledge    knowledge_items? @relation(fields: [knowledge_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id, created_at, id], map: "learner_errors_user_id_created_at_id_idx")
  @@index([user_id, knowledge_id], map: "learner_errors_user_id_knowledge_id_idx")
  @@index([attempt_id], map: "learner_errors_attempt_id_idx")
}
