# LinguaAI — AI Service Environment Variables
# Copy this file to .env and replace every <...> placeholder locally.
# Never commit real keys. See docs/provider-setup.md for names and rotation.

# ── LLM Provider (Groq Cloud) ──
GROQ_API_KEY=<replace-with-groq-api-key>
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_LIGHT=llama-3.1-8b-instant
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile

# ── LLM Parameters ──
MAX_TOKENS=2048
TEMPERATURE=0.3
REQUEST_TIMEOUT=60

# ── API Security ──
# Comma-separated list of allowed API keys. REQUIRED in production.
# In development leave empty to allow all requests without auth.
# Generate keys locally; never paste generated keys into this file.
AI_SERVICE_API_KEYS=

# ── Cache / Rate limiting (Redis, optional locally) ──
# REDIS_URL may embed credentials; if set, treat it as a secret.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<replace-with-redis-password-or-leave-empty>

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Environment ──
# Set to "production" to enforce API key validation and Groq key presence.
APP_ENV=development
DEBUG=false
