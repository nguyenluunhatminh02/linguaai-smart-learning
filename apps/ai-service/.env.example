# LinguaAI — AI Service Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Provider (Groq Cloud) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=llama-3.3-70b-versatile

# ── LLM Parameters ──
MAX_TOKENS=2048
TEMPERATURE=0.3
REQUEST_TIMEOUT=60

# ── API Security ──
# Comma-separated list of allowed API keys. REQUIRED in production.
# In development leave empty to allow all requests without auth.
AI_SERVICE_API_KEYS=

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Environment ──
# Set to "production" to enforce API key validation and Groq key presence.
APP_ENV=development
DEBUG=false
