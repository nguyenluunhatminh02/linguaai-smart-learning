# ═══════════════════════════════════════════════
# LinguaAI - Environment Variables
# ═══════════════════════════════════════════════

# ── Database ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=linguaai
DATABASE_PASSWORD=linguaai_secret
DATABASE_NAME=linguaai
DATABASE_URL=postgresql://linguaai:linguaai_secret@localhost:5432/linguaai

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-change-in-production

# ── Groq Cloud ──
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_LIGHT=llama-3.1-8b-instant
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile

# ── AI Service ──
AI_SERVICE_URL=http://localhost:8000
# Comma-separated list of allowed keys. REQUIRED in production (AI service refuses to boot without it).
# Generate with: openssl rand -hex 32
AI_SERVICE_API_KEYS=

# ── App ──
NODE_ENV=development
# AI service uses APP_ENV (or NODE_ENV) to detect production.
APP_ENV=development
API_PORT=3001
WEB_PORT=3000
AI_PORT=8000

# ── CORS ──
# Comma-separated list of allowed origins. REQUIRED for the API in production.
CORS_ORIGINS=http://localhost:3000

# ── Swagger ──
# In production Swagger is disabled by default. Set to "true" to expose /api/docs.
SWAGGER_ENABLED=false
