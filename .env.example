# ═══════════════════════════════════════════════
# LinguaAI - Environment Variables
# ═══════════════════════════════════════════════

# Copy to .env; replace every <...> placeholder locally. Never commit real values.
# See docs/provider-setup.md for variable names, owners and rotation guidance.

# ── Database ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=linguaai
DATABASE_PASSWORD=<replace-with-database-password>
DATABASE_NAME=linguaai
# Embed the same password only in the local .env file, never in this example.
DATABASE_URL=<replace-with-postgresql-connection-url>
# Docker Compose (password also used for the postgres container):
POSTGRES_USER=linguaai
POSTGRES_DB=linguaai
POSTGRES_PASSWORD=<replace-with-postgres-password>

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<replace-with-redis-password>
# Optional; may embed credentials, so treat as a secret if used.
# Leave empty unless your Redis provider requires a URL.
REDIS_URL=

# ── JWT ──
JWT_SECRET=<replace-with-jwt-signing-secret>
JWT_REFRESH_SECRET=<replace-with-jwt-refresh-secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
MFA_ENCRYPTION_KEY=<replace-with-mfa-encryption-key>

# ── Groq Cloud ──
GROQ_API_KEY=<replace-with-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_LIGHT=llama-3.1-8b-instant
GROQ_MODEL_HEAVY=llama-3.3-70b-versatile

# ── AI Service ──
AI_SERVICE_URL=http://localhost:8000
# Comma-separated list of allowed keys. REQUIRED in production (AI service refuses to boot without it).
# Generate a random key locally; never paste generated keys into this file.
AI_SERVICE_API_KEYS=<replace-with-one-or-more-ai-service-keys>

# ── App ──
NODE_ENV=development
# AI service uses APP_ENV (or NODE_ENV) to detect production.
APP_ENV=development
API_PORT=3001
WEB_PORT=3000
AI_PORT=8000

# ── CORS ──
# Comma-separated list of allowed origins. REQUIRED for the API in production.
CORS_ORIGINS=http://localhost:3000

# ── Swagger ──
# In production Swagger is disabled by default. Set to "true" to expose /api/docs.
SWAGGER_ENABLED=false

# ── Encrypted backups (ops-19 / DB-05) ──
# scripts/backup.sh does NOT source .env; export these from the job environment
# or secret store. Names only — never commit values, DSNs or key material.
# BACKUP_SOURCE_ALIAS=<logical-database-alias>
# BACKUP_STAGE_DIR=<private-backup-stage-directory>
# BACKUP_GPG_RECIPIENT=<gpg-recipient-id>
# BACKUP_SIGNING_KEY=<optional-gpg-signing-key-id>
# GNUPGHOME=<private-gnupg-home>
# BACKUP_RETENTION_DAILY=<count>
# BACKUP_RETENTION_WEEKLY=<count>
# BACKUP_RETENTION_MONTHLY=<count>
# BACKUP_MIN_KEEP=<minimum-count>
# BACKUP_DRY_RUN=<0-or-1>
# RESTORE_TARGET_URL=<isolated-target-url>
# ALLOW_RESTORE=<0-or-1>
