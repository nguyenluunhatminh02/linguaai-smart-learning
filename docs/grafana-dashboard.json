        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "100 * sum(rate(http_request_duration_seconds_count{status=~\"4xx|5xx|4[0-9][0-9]|5[0-9][0-9]\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])), 1)",
