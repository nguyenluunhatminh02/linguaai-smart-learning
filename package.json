{
  "name": "linguaai",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Language Learning Platform with LLM and Spaced Repetition",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:api": "turbo dev --filter=api",
    "dev:ai": "pnpm --dir apps/ai-service exec python -m uvicorn app.main:app --reload --port 8000",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:migrate": "turbo run db:migrate --filter=api",
    "db:generate": "turbo run db:generate --filter=api",
    "db:seed": "turbo run db:seed --filter=api",
    "docker:dev": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "puppeteer": "^25.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
